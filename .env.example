# Copy to .env and fill in. Never commit .env.
# Full reference: docs/CONFIGURATION.md

RATCHET_MODE=live                      # mock | live
RATCHET_DB=ratchet.db

# Teacher + judge on Nebius Token Factory
NEBIUS_API_KEY=
RATCHET_TEACHER_BASE=https://api.tokenfactory.nebius.com/v1
RATCHET_TEACHER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
RATCHET_JUDGE_MODEL=nvidia/nemotron-3-super-120b-a12b
RATCHET_FALLBACK_STUDENT=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Student on a Nebius Serverless Endpoint (vLLM)
RATCHET_STUDENT_BASE=                  # https://<endpoint>/v1
RATCHET_STUDENT_KEY=
RATCHET_STUDENT_BASE_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-4B-BF16

# Cascade
RATCHET_SAMPLES=3
RATCHET_AUDIT_RATE=0.05
RATCHET_CONFIDENCE_THRESHOLD=0.80
RATCHET_GOLDEN_FRACTION=0.10

# Release policy overrides (optional): RATCHET_<FIELD>
# RATCHET_MIN_AUDITS=20
# RATCHET_LIVE_FLOOR=0.92

# Scout, the multi-agent demo (docs/SCOUT.md)
TAVILY_API_KEY=
RATCHET_SCOUT_DAILY_BUDGET_USD=3.00
RATCHET_SCOUT_RUNS_PER_HOUR=6
RATCHET_SCOUT_MAX_RUNS_PER_DAY=30
RATCHET_SCOUT_MAX_RESULTS=4
RATCHET_TRUST_PROXY=0                  # 1 = take the client IP from X-Forwarded-For (only behind a proxy you control)

# Privacy and security (docs/CONFIGURATION.md)
RATCHET_REDACT_PII=1                   # 0 = store examples verbatim (not recommended with real data)
RATCHET_API_KEYS=                      # name:key,name:key (keys >= 16 chars); empty = /v1/* is open
RATCHET_API_KEY_DAILY_REQUESTS=0       # per key per UTC day; 0 = unlimited
RATCHET_BOM_SIGNING_KEY=               # python -m ratchet.bom keygen; empty = BOMs stored unsigned

# Mock mode only
RATCHET_MOCK_WARMUP_DAYS=0             # 4 = start the demo with a trained student
RATCHET_MOCK_WARMUP_REQUESTS=1500
RATCHET_MOCK_PACE=0.25

# Night School on Nebius
RATCHET_BUCKET_ID=
RATCHET_BUCKET_S3=                     # s3://bucket/prefix
RATCHET_S3_ENDPOINT=
RATCHET_TRAIN_IMAGE=
RATCHET_DATA_DIR=data
RATCHET_SYNC_CMD=
RATCHET_TRAIN_CMD=bash deploy/train_job.sh {version}
RATCHET_ADAPTER_ROOT=/data/adapters
