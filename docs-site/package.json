{
  "name": "ratchet-docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Ratchet documentation site (Starlight). Source docs stay in ../docs and are synced in at build time.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "predev": "node scripts/sync-docs.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/sync-docs.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "wrangler pages deploy dist --project-name ratchet-docs --branch main",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "@astrojs/starlight": "0.42.6",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "astro": "7.3.8",
    "astro-mermaid": "2.1.0",
    "lucode-starlight": "1.0.0",
    "mermaid": "11.17.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "starlight-links-validator": "0.27.0",
    "starlight-openapi": "0.27.0"
  },
  "devDependencies": {
    "playwright-core": "1.58.2"
  }
}
