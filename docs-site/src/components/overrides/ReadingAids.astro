---
/**
 * Small helpers for reading a long doc page, on every doc page (rendered by Footer.astro). No framework, no work while
 * the reader scrolls beyond a class change in a requestAnimationFrame.
 *
 * - Expand: every diagram gets an "Expand" button once Mermaid has drawn it, and content images open on click. Both
 *   open in a full-screen dialog at the screen's width (a tall one scrolls), with "Fit to screen" to see all of it
 *   at once (after beUI's Image Viewer, MIT). Esc, the close button or a click outside closes it.
 * - Back to top: a button that appears once the page title is out of view, below 1280px (wider, "On this page"
 *   shows, and its "Overview" link does the same).
 * - Tables: a table that scrolls sideways fades out at the edge that has more to show.
 * - Heading links: the link icon next to a heading also copies the section's address.
 *
 * Nothing here has an `id` inside <main>: Starlight's "On this page" script walks back from every `main [id]`.
 */
---

<button type="button" class="rt-top" aria-label="Back to top" hidden>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
    <path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</button>

<dialog class="rt-zoom" aria-label="Expanded view">
  <div class="rt-zoom__bar">
    <button type="button" class="rt-zoom__btn" data-zoom-size aria-pressed="false">Fit to screen</button>
    <button type="button" class="rt-zoom__btn" data-zoom-close aria-label="Close">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
  <div class="rt-zoom__stage"></div>
</dialog>

<span class="rt-copied" role="status" aria-live="polite"></span>

<script>
  const content = document.querySelector<HTMLElement>('.sl-markdown-content');

  // ---------- Expand ----------
  const dialog = document.querySelector<HTMLDialogElement>('dialog.rt-zoom');
  const stage = dialog?.querySelector<HTMLElement>('.rt-zoom__stage');
  const sizeBtn = dialog?.querySelector<HTMLButtonElement>('[data-zoom-size]');

  const open = (node: Element) => {
    if (!dialog || !stage || !sizeBtn) return;
    const copy = node.cloneNode(true) as HTMLElement;
    // Mermaid scopes a diagram's styles to its svg's id: the copy gets its own id, and its styles follow it.
    if (copy.id) {
      const id = copy.id;
      copy.id = `${id}-zoom`;
      copy.querySelectorAll('style').forEach((style) => {
        style.textContent = (style.textContent ?? '').split(`#${id}`).join(`#${id}-zoom`);
      });
    }
    copy.removeAttribute('style');
    copy.removeAttribute('width');
    copy.removeAttribute('height');
    stage.replaceChildren(copy);
    dialog.dataset.fit = 'false';
    sizeBtn.setAttribute('aria-pressed', 'false');
    sizeBtn.textContent = 'Fit to screen';
    dialog.showModal();
  };
  sizeBtn?.addEventListener('click', () => {
    if (!dialog) return;
    const fit = dialog.dataset.fit !== 'true';
    dialog.dataset.fit = String(fit);
    sizeBtn.setAttribute('aria-pressed', String(fit));
    sizeBtn.textContent = fit ? 'Full width' : 'Fit to screen';
  });
  dialog?.querySelector('[data-zoom-close]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog || event.target === stage) dialog.close();
  });
  dialog?.addEventListener('close', () => stage?.replaceChildren());

  const addExpand = (pre: HTMLElement) => {
    if (pre.querySelector(':scope > .rt-expand') || !pre.querySelector('svg')) return;
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'rt-expand';
    button.textContent = 'Expand';
    button.setAttribute('aria-label', 'Expand diagram');
    button.addEventListener('click', () => {
      const svg = pre.querySelector('svg');
      if (svg) open(svg);
    });
    pre.append(button);
  };
  // Mermaid replaces each block's content when it draws, then marks it data-processed.
  const diagrams = content ? Array.from(content.querySelectorAll<HTMLElement>('pre.mermaid')) : [];
  diagrams.forEach((pre) => {
    if (pre.hasAttribute('data-processed')) addExpand(pre);
    else
      new MutationObserver((_, observer) => {
        if (pre.hasAttribute('data-processed') && pre.querySelector('svg')) {
          observer.disconnect();
          addExpand(pre);
        }
      }).observe(pre, { attributes: true, childList: true });
  });
  content?.querySelectorAll<HTMLImageElement>('img').forEach((img) => {
    if (img.closest('a, .rt-ui, .not-content') || img.naturalWidth < 480) return;
    img.classList.add('rt-zoomable');
    img.tabIndex = 0;
    img.setAttribute('role', 'button');
    img.setAttribute('aria-label', `${img.alt || 'Image'} (expand)`);
    img.addEventListener('click', () => open(img));
    img.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        open(img);
      }
    });
  });

  // ---------- Back to top ----------
  const top = document.querySelector<HTMLButtonElement>('.rt-top');
  const title = document.querySelector('[data-page-title]');
  if (top && title) {
    new IntersectionObserver(([entry]) => {
      top.hidden = entry.isIntersecting || entry.boundingClientRect.top > 0;
    }).observe(title);
    top.addEventListener('click', () => window.scrollTo({ top: 0 }));
  }

  // ---------- Tables that scroll sideways ----------
  const edge = (table: HTMLElement) => {
    const more = table.scrollWidth - table.clientWidth > 2;
    const atStart = table.scrollLeft <= 1;
    const atEnd = table.scrollLeft >= table.scrollWidth - table.clientWidth - 1;
    table.dataset.more = !more ? '' : atStart ? 'end' : atEnd ? 'start' : 'both';
  };
  const tables = content ? Array.from(content.querySelectorAll<HTMLElement>(':scope table')) : [];
  tables.forEach((table) => {
    edge(table);
    let queued = false;
    table.addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          edge(table);
        });
      },
      { passive: true },
    );
  });
  if (tables.length) new ResizeObserver(() => tables.forEach(edge)).observe(content as HTMLElement);

  // ---------- Heading links copy the address ----------
  const status = document.querySelector<HTMLElement>('.rt-copied');
  let hideTimer = 0;
  content?.addEventListener('click', (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a.sl-anchor-link');
    if (!link || !navigator.clipboard) return;
    navigator.clipboard.writeText(link.href).then(
      () => {
        if (!status) return;
        status.textContent = 'Link to this section copied';
        status.dataset.shown = '';
        clearTimeout(hideTimer);
        hideTimer = window.setTimeout(() => delete status.dataset.shown, 1800);
      },
      () => {},
    );
  });
</script>

<style>
  .rt-top {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 40;
    display: inline-grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--rt-line-strong);
    border-radius: 999px;
    background: var(--rt-surface);
    color: var(--rt-ink-2);
    box-shadow: var(--rt-shadow);
    cursor: pointer;
    transition:
      color var(--rt-dur) ease,
      border-color var(--rt-dur) ease;
  }
  .rt-top:hover {
    border-color: var(--rt-muted);
    color: var(--rt-ink);
  }
  .rt-top[hidden] {
    display: none;
  }
  /* Where "On this page" shows (Lucode's 1280px), its "Overview" link already goes to the top. */
  @media (min-width: 1280px) {
    .rt-top {
      display: none;
    }
  }
  @media (max-width: 50rem) {
    .rt-top {
      right: 1rem;
      bottom: 1rem;
    }
  }

  .rt-zoom {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--rt-bg);
    color: var(--rt-ink);
  }
  .rt-zoom::backdrop {
    background: var(--rt-bg);
  }
  .rt-zoom[open] {
    display: flex;
    flex-direction: column;
  }
  .rt-zoom__bar {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--rt-line);
  }
  .rt-zoom__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.25rem;
    padding: 0 0.85rem;
    border: 1px solid var(--rt-line-strong);
    border-radius: 999px;
    background: var(--rt-surface);
    color: var(--rt-ink);
    font: 500 0.85rem var(--rt-font-sans);
    cursor: pointer;
  }
  .rt-zoom__btn:hover {
    background: var(--rt-surface-2);
  }
  .rt-zoom__stage {
    flex: 1;
    display: grid;
    justify-items: center;
    align-items: start;
    min-height: 0;
    padding: 1.5rem;
    overflow: auto;
  }
  .rt-zoom__stage > :global(*) {
    width: min(100%, 90rem);
    max-width: 100%;
    height: auto;
  }
  .rt-zoom__stage > :global(img) {
    width: auto;
  }
  .rt-zoom[data-fit='true'] .rt-zoom__stage {
    align-items: center;
    overflow: hidden;
  }
  .rt-zoom[data-fit='true'] .rt-zoom__stage > :global(*) {
    width: auto;
    height: 100%;
    max-height: 100%;
  }

  .rt-copied {
    position: fixed;
    left: 50%;
    bottom: 1.5rem;
    z-index: 60;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--rt-line-strong);
    border-radius: 999px;
    background: var(--rt-surface);
    color: var(--rt-ink);
    box-shadow: var(--rt-shadow-lift);
    font-size: 0.85rem;
    translate: -50% 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }
  .rt-copied[data-shown] {
    opacity: 1;
  }
  .rt-copied:empty {
    display: none;
  }
</style>
