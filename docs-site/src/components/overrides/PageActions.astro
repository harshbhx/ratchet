---
/**
 * An "Ask AI" menu under every page title: open this page in ChatGPT, Claude or Perplexity, copy the page text, or copy its link.
 * The three assistant links carry a short prompt that names this page's public address, so the assistant reads the live page.
 * Nothing is sent from this site; the page text is copied only when the reader chooses "Copy page".
 */
const route = Astro.locals.starlightRoute;
const title = String(route.entry.data.title ?? 'this page');
const page = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const prompt = `Read this page of the Ratchet documentation: ${page}\n\nThen answer my questions about it. Quote the page where you can, and say so when the page does not cover something.`;
const q = encodeURIComponent(prompt);
const items = [
  { label: 'Open in ChatGPT', hint: 'Ask ChatGPT about this page', href: `https://chatgpt.com/?q=${q}`, icon: 'M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.4A8 8 0 1 1 21 12Z' },
  { label: 'Open in Claude', hint: 'Ask Claude about this page', href: `https://claude.ai/new?q=${q}`, icon: 'M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4' },
  { label: 'Open in Perplexity', hint: 'Search with this page as the source', href: `https://www.perplexity.ai/search?q=${q}`, icon: 'M12 3 4 8v8l8 5 8-5V8l-8-5Zm0 0v18M4 8l8 5 8-5' },
];
---

<div class="rt-ask" data-title={title} data-url={page}>
  <details class="rt-ask__menu">
    <summary class="rt-ask__trigger" aria-haspopup="menu">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3Z"></path><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15Z"></path></svg>
      Ask AI
      <svg class="rt-ask__chev" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
    </summary>
    <div class="rt-ask__list" role="menu" aria-label="Ask AI about this page">
      {
        items.map((it) => (
          <a class="rt-ask__item" role="menuitem" href={it.href} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={it.icon}></path></svg>
            <span><strong>{it.label}</strong><small>{it.hint}</small></span>
            <svg class="rt-ask__out" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg>
          </a>
        ))
      }
      <hr class="rt-ask__rule" />
      <button type="button" class="rt-ask__item" role="menuitem" data-copy="page">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V6a2 2 0 0 1 2-2h9"></path></svg>
        <span><strong>Copy page</strong><small>The text of this page, to paste anywhere</small></span>
      </button>
      <button type="button" class="rt-ask__item" role="menuitem" data-copy="link">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"></path><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"></path></svg>
        <span><strong>Copy link</strong><small>The address of this page</small></span>
      </button>
    </div>
  </details>
  <span class="rt-ask__status" role="status" aria-live="polite" data-status></span>
</div>

<style>
  .rt-ask {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .rt-ask__menu {
    position: relative;
  }
  .rt-ask__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.8rem;
    list-style: none;
    border: 1px solid var(--rt-line, var(--sl-color-hairline));
    border-radius: 999px;
    background: var(--sl-color-bg-nav, transparent);
    color: var(--sl-color-gray-1);
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1.2;
    cursor: pointer;
    user-select: none;
  }
  .rt-ask__trigger::-webkit-details-marker {
    display: none;
  }
  .rt-ask__trigger:hover,
  .rt-ask__menu[open] > .rt-ask__trigger {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-3);
  }
  .rt-ask__trigger:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .rt-ask__chev {
    transition: transform 0.15s;
  }
  .rt-ask__menu[open] .rt-ask__chev {
    transform: rotate(180deg);
  }
  .rt-ask__list {
    position: absolute;
    z-index: 30;
    top: calc(100% + 0.4rem);
    left: 0;
    min-width: 18.5rem;
    max-width: calc(100vw - 2rem);
    padding: 0.35rem;
    border: 1px solid var(--rt-line, var(--sl-color-hairline));
    border-radius: 0.8rem;
    background: var(--sl-color-bg);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.18);
  }
  .rt-ask__item {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: 100%;
    padding: 0.5rem 0.6rem;
    border: 0;
    border-radius: 0.55rem;
    background: transparent;
    color: var(--sl-color-gray-1);
    font: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .rt-ask__item > span {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }
  .rt-ask__item strong {
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .rt-ask__item small {
    font-size: 0.74rem;
    color: var(--sl-color-gray-3);
  }
  .rt-ask__out {
    color: var(--sl-color-gray-3);
  }
  .rt-ask__item:hover,
  .rt-ask__item:focus-visible {
    background: var(--sl-color-gray-6);
    outline: none;
  }
  .rt-ask__rule {
    height: 1px;
    margin: 0.3rem 0.4rem;
    border: 0;
    background: var(--rt-line, var(--sl-color-hairline));
  }
  .rt-ask__status {
    font-size: 0.78rem;
    color: var(--sl-color-gray-3);
  }
  @media (prefers-reduced-motion: reduce) {
    .rt-ask__chev {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.rt-ask').forEach((box) => {
    const menu = box.querySelector<HTMLDetailsElement>('details');
    const status = box.querySelector<HTMLElement>('[data-status]');
    if (!menu) return;
    // The page address was written at build time from the configured site name. Use the address the reader is on instead, so the
    // assistants always get a page that exists, whichever host serves the docs (pages.dev now, a custom domain later).
    const here = location.origin + location.pathname;
    box.dataset.url = here;
    menu.querySelectorAll<HTMLAnchorElement>('a[role="menuitem"]').forEach((a) => {
      const u = new URL(a.href);
      const q = u.searchParams.get('q');
      if (q) {
        u.searchParams.set('q', q.replace(/https?:\/\/\S+/, here));
        a.href = u.toString();
      }
    });
    const close = (focus = false) => {
      menu.open = false;
      if (focus) menu.querySelector<HTMLElement>('summary')?.focus();
    };
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) close();
    });
    menu.addEventListener('keydown', (e) => {
      const items = [...menu.querySelectorAll<HTMLElement>('[role="menuitem"]')];
      const i = items.indexOf(document.activeElement as HTMLElement);
      if (e.key === 'Escape') {
        close(true);
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        items[(i + 1) % items.length]?.focus();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        items[(i - 1 + items.length) % items.length]?.focus();
      }
    });
    menu.querySelectorAll<HTMLAnchorElement>('a[role="menuitem"]').forEach((a) => a.addEventListener('click', () => close()));
    menu.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const article = document.querySelector<HTMLElement>('.sl-markdown-content');
        const text =
          btn.dataset.copy === 'link'
            ? (box.dataset.url ?? '')
            : `# ${box.dataset.title}\n\n${article?.innerText ?? ''}\n\nSource: ${box.dataset.url}`;
        let ok = false;
        try {
          await navigator.clipboard.writeText(text);
          ok = true;
        } catch {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try {
            ok = document.execCommand('copy');
          } catch {
            ok = false;
          }
          ta.remove();
        }
        if (status) status.textContent = ok ? (btn.dataset.copy === 'link' ? 'Link copied' : 'Page copied') : 'Could not copy';
        close(true);
        setTimeout(() => {
          if (status) status.textContent = '';
        }, 2200);
      });
    });
  });
</script>
