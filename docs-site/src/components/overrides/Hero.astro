---
/**
 * Splash-page hero. Replaces Lucode's Hero with Ratchet's compact docs header (src/components/home/HomeHero.astro):
 * the title, tagline and actions come from the page's `hero` frontmatter. Only the home page has a hero.
 */
import HomeHero from '../home/HomeHero.astro';

const { data } = Astro.locals.starlightRoute.entry;
const hero = data.hero ?? {};
const actions = (hero.actions ?? []).map((a: any) => ({
  text: a.text as string,
  link: a.link as string,
  variant: (a.variant as string) ?? 'default',
}));
---

<HomeHero title={(hero.title as string) ?? data.title} tagline={(hero.tagline as string) ?? data.description} actions={actions} />
