---
/**
 * "In plain words": the everyday analogy that opens every guide page. <PlainWords> is the same component.
 * Props: title (default "In plain words").
 */
interface Props {
  title?: string;
}
const { title = 'In plain words' } = Astro.props;
---

<section class="rt-eli10 rt-ui" aria-label={title}>
  <div class="rt-eli10-head">
    <span class="rt-eli10-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="16" height="16" focusable="false">
        <path
          d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.6.5 1 1.2 1.1 2V16h5v-.2c.1-.8.5-1.5 1.1-2A6 6 0 0 0 12 3Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
    <span class="rt-eli10-title">{title}</span>
  </div>
  <div class="rt-eli10-body"><slot /></div>
</section>

<style>
  .rt-eli10 {
    position: relative;
    margin: 1.5rem 0 2.25rem;
    padding: 1.15rem 1.35rem 1.3rem;
    border: 1px solid var(--rt-line);
    border-radius: var(--rt-radius-lg);
    background: color-mix(in srgb, var(--rt-warn) 5%, var(--rt-surface));
  }
  .rt-eli10-head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.6rem;
  }
  .rt-eli10-icon {
    display: inline-grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 999px;
    background: var(--rt-warn-soft);
    color: var(--rt-warn);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--rt-warn) 30%, transparent);
  }
  .rt-eli10-title {
    color: var(--rt-ink);
    font-family: var(--rt-font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .rt-eli10-body {
    color: var(--rt-ink-2);
    font-size: 1rem;
    line-height: 1.75;
  }
  .rt-eli10-body :global(> :first-child) {
    margin-top: 0;
  }
  .rt-eli10-body :global(> :last-child) {
    margin-bottom: 0;
  }
  .rt-eli10-body :global(strong) {
    color: var(--rt-ink);
  }
  .rt-eli10-body :global(p) {
    max-width: 66ch;
  }
</style>
