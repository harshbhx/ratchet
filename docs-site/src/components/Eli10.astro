---
/** "In plain words": the everyday analogy that opens every guide page. */
interface Props {
  title?: string;
}
const { title = "In plain words" } = Astro.props;
---

<section class="rt-eli10" aria-label={title}>
  <div class="rt-eli10-head">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
      <path
        d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.6.5 1 1.2 1.1 2V16h5v-.2c.1-.8.5-1.5 1.1-2A6 6 0 0 0 12 3Z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    <span>{title}</span>
  </div>
  <div class="rt-eli10-body"><slot /></div>
</section>

<style>
  .rt-eli10 {
    margin: 1.5rem 0 2rem;
    padding: 1.1rem 1.25rem 1.2rem;
    border: 1px solid var(--rt-line);
    border-radius: 1rem;
    background:
      linear-gradient(to right, var(--rt-grid) 1px, transparent 1px) 0 0 / 22px 22px,
      linear-gradient(to bottom, var(--rt-grid) 1px, transparent 1px) 0 0 / 22px 22px,
      var(--rt-surface-2);
  }
  .rt-eli10-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    color: var(--rt-ink);
    font-weight: 650;
    font-size: var(--sl-text-base);
    letter-spacing: -0.01em;
  }
  .rt-eli10-head svg {
    color: var(--rt-warn);
    flex: none;
  }
  .rt-eli10-body {
    color: var(--rt-ink-2);
    font-size: var(--sl-text-base);
  }
  .rt-eli10-body :global(> :first-child) {
    margin-top: 0;
  }
  .rt-eli10-body :global(> :last-child) {
    margin-bottom: 0;
  }
  .rt-eli10-body :global(strong) {
    color: var(--rt-ink);
  }
</style>
