---
/**
 * <Compare>: two columns side by side (stacked on narrow screens): before and after, rented and owned, A and B.
 * Put each side in a named slot. By default the left side wears the rented orange (the teacher) and the right
 * side the owned blue (the student); set the tones to 'neutral' when the comparison is not about them.
 *
 *   <Compare before="Every request to the teacher" after="With Ratchet">
 *     <div slot="before">You pay per token for every request, repeated or not.</div>
 *     <div slot="after">The student answers what it is sure about; the teacher answers the rest.</div>
 *   </Compare>
 */
interface Props {
  before?: string;
  after?: string;
  beforeTone?: 'owned' | 'rented' | 'neutral';
  afterTone?: 'owned' | 'rented' | 'neutral';
  caption?: string;
}

const { before = 'Before', after = 'After', beforeTone = 'rented', afterTone = 'owned', caption } = Astro.props;
---

<figure class="rt-compare rt-ui not-content">
  <div class="rt-compare__grid">
    <section class={`rt-compare__side rt-compare__side--${beforeTone}`} aria-label={before}>
      <p class="rt-compare__label"><span class="rt-compare__dot" aria-hidden="true"></span>{before}</p>
      <div class="rt-compare__body"><slot name="before" /></div>
    </section>
    <div class="rt-compare__arrow" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </div>
    <section class={`rt-compare__side rt-compare__side--${afterTone}`} aria-label={after}>
      <p class="rt-compare__label"><span class="rt-compare__dot" aria-hidden="true"></span>{after}</p>
      <div class="rt-compare__body"><slot name="after" /></div>
    </section>
  </div>
  {caption && <figcaption class="rt-compare__caption">{caption}</figcaption>}
</figure>

<style>
  .rt-compare {
    container-type: inline-size;
    margin: 1.75rem 0;
  }
  .rt-compare__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
    align-items: stretch;
  }
  @container (min-width: 36rem) {
    .rt-compare__grid {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: 0.6rem;
    }
  }
  .rt-compare__side {
    --tone: var(--rt-line-strong);
    --tone-soft: var(--rt-surface-2);
    --tone-ink: var(--rt-ink);
    position: relative;
    padding: 1rem 1.15rem 1.1rem;
    border: 1px solid var(--rt-line);
    border-top: 2px solid var(--tone);
    border-radius: var(--rt-radius-lg);
    background: linear-gradient(to bottom, var(--tone-soft), var(--rt-surface) 70%);
  }
  .rt-compare__side--owned {
    --tone: var(--rt-owned);
    --tone-soft: var(--rt-owned-soft);
    --tone-ink: var(--rt-owned-ink);
  }
  .rt-compare__side--rented {
    --tone: var(--rt-rented);
    --tone-soft: var(--rt-rented-soft);
    --tone-ink: var(--rt-rented-ink);
  }
  .rt-compare__label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    color: var(--tone-ink);
    font-family: var(--rt-font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .rt-compare__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--tone);
  }
  .rt-compare__body {
    color: var(--rt-ink-2);
    font-size: 0.95rem;
    line-height: 1.65;
  }
  .rt-compare__body :global(> *) {
    margin: 0;
  }
  .rt-compare__body :global(> * + *) {
    margin-top: 0.6rem;
  }
  .rt-compare__body :global(ul) {
    padding-inline-start: 1.1rem;
  }
  .rt-compare__body :global(strong) {
    color: var(--rt-ink);
  }
  .rt-compare__arrow {
    display: grid;
    place-items: center;
    color: var(--rt-muted);
    transform: rotate(90deg);
  }
  @container (min-width: 36rem) {
    .rt-compare__arrow {
      transform: none;
    }
  }
  .rt-compare__caption {
    margin-top: 0.6rem;
    color: var(--rt-muted);
    font-size: 0.85rem;
  }
</style>
