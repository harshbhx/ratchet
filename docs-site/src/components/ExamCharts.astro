---
/**
 * <ExamCharts>: charts and cards for the two text-to-SQL exams, drawn at build time from src/data/exams.json (written by
 * scripts/text2sql/exam_numbers.py from the saved answers; tests/test_exam_numbers.py fails when it is stale).
 *
 *   <ExamCharts kind="scores" exam="exam2" />       bars: how many questions each model got right, with the 95% range
 *   <ExamCharts kind="difficulty" exam="exam2" />   bars by question difficulty: base model and the two adapters
 *   <ExamCharts kind="flips" />                     questions that changed between the round 1 and round 2 adapter
 *   <ExamCharts kind="authors" />                   who wrote the training examples and each exam, and how it was checked
 */
import data from '../data/exams.json';

interface Props {
  kind: 'scores' | 'difficulty' | 'flips' | 'authors';
  exam?: 'exam1' | 'exam2';
}
const { kind, exam = 'exam1' } = Astro.props;

const MODELS = ['base', 'teacher', 'r1', 'r2'] as const;
const STYLE: Record<string, { color: string; opacity: number }> = {
  base: { color: 'var(--rt-muted)', opacity: 0.55 },
  teacher: { color: 'var(--rt-rented)', opacity: 1 },
  r1: { color: 'var(--rt-owned)', opacity: 0.55 },
  r2: { color: 'var(--rt-owned)', opacity: 1 },
};
const short: Record<string, string> = Object.fromEntries(data.models.map((m) => [m.id, m.short]));
const info = data.exams.find((e) => e.id === exam)!;
const pct = (r: number) => `${(r * 100).toFixed(1)}%`;
// Charts are HTML, not a scaled SVG: the text stays at reading size at any width and a value is never cut off.
const share = (v: number, max: number) => `${(Math.max(0, Math.min(1, v / max)) * 100).toFixed(2)}%`;
const ticks = (max: number, step: number) => {
  const t: number[] = [];
  for (let v = 0; v <= max + 1e-9; v += step) t.push(Math.round(v * 100) / 100);
  return t;
};
const NAME: Record<string, string> = { base: 'base', r1: 'round 1', r2: 'round 2' };

const scoreMax = 0.6;
const diffMax = 0.8;
const diffIds = ['base', 'r1', 'r2'] as const;
const diffs = ['simple', 'join', 'aggregate', 'hard'] as const;
const flipMax = 26;
---

{
  kind === 'scores' && (
    <figure class="rt-xc">
      <div class="rt-xc__plot" role="img" aria-label={`${info.name}: share of ${info.rows} questions answered exactly right, by model`}>
        <div class="rt-xc__grid" style={`grid-row: 1 / span ${MODELS.length}`} aria-hidden="true">
          {ticks(scoreMax, 0.2).map((t) => <span style={`--x: ${share(t, scoreMax)}`} />)}
        </div>
        {MODELS.map((id, i) => {
          const s = (data.scores as any)[exam][id];
          const st = STYLE[id];
          return (
            <div class:list={['rt-xc__row', { 'rt-xc__row--key': id === 'r2' }]}>
              <span class="rt-xc__label" style={`grid-row: ${i + 1}`}>{short[id]}</span>
              <span class="rt-xc__track" style={`grid-row: ${i + 1}`}>
                <span class="rt-xc__bar" style={`--w: ${share(s.rate, scoreMax)}; --c: ${st.color}; --o: ${st.opacity}`} />
                <span class="rt-xc__range" style={`--lo: ${share(s.lo, scoreMax)}; --hi: ${share(s.hi, scoreMax)}`} />
              </span>
              <span class="rt-xc__value" style={`grid-row: ${i + 1}`}>
                {pct(s.rate)} <small>{s.agree}/{s.n}</small>
              </span>
            </div>
          );
        })}
        <div class="rt-xc__row rt-xc__row--axis" aria-hidden="true">
          <span class="rt-xc__ticks">{ticks(scoreMax, 0.2).map((t) => <span style={`--x: ${share(t, scoreMax)}`}>{Math.round(t * 100)}%</span>)}</span>
        </div>
      </div>
      <figcaption>
        {info.name}: {info.rows} questions, written by {info.writer.split(',')[0]}. The line on each bar is the 95% range.
      </figcaption>
    </figure>
  )
}

{
  kind === 'difficulty' && (
    <figure class="rt-xc">
      <p class="rt-xc__key" aria-hidden="true">
        {diffIds.map((id) => (
          <span>
            <i style={`--c: ${STYLE[id].color}; --o: ${STYLE[id].opacity}`} />
            {id === 'base' ? 'Base model' : id === 'r1' ? 'Adapter, round 1' : 'Adapter, round 2'}
          </span>
        ))}
      </p>
      <div class="rt-xc__plot" role="img" aria-label={`${info.name}: share right by question difficulty, base model and the two adapters`}>
        {diffs.map((d) => {
          const row = (data.difficulty as any)[exam][d];
          return (
            <div class="rt-xc__group">
              <span class="rt-xc__label">
                {d}
                <small>{row.n} questions</small>
              </span>
              <span class="rt-xc__bars">
                {diffIds.map((id) => (
                  <span class="rt-xc__track rt-xc__track--thin" title={`${NAME[id]}: ${row[id]} of ${row.n}`}>
                    <span class="rt-xc__bar" style={`--w: ${share(row[id] / row.n, diffMax)}; --c: ${STYLE[id].color}; --o: ${STYLE[id].opacity}`} />
                    <span class="rt-xc__end" style={`--w: ${share(row[id] / row.n, diffMax)}`}>
                      {row[id]}/{row.n}
                    </span>
                  </span>
                ))}
              </span>
            </div>
          );
        })}
      </div>
      <figcaption>{info.name}, by difficulty. Join questions improved most from round 1 to round 2; simple questions did not.</figcaption>
    </figure>
  )
}

{
  kind === 'flips' && (
    <figure class="rt-xc">
      <div class="rt-xc__plot" role="img" aria-label="Questions that changed between the round 1 and the round 2 adapter, on both exams">
        {(['exam1', 'exam2'] as const).map((ex) => {
          const f = (data.r1_to_r2 as any)[ex];
          return (
            <div class="rt-xc__row">
              <span class="rt-xc__label">{ex === 'exam1' ? 'Exam 1' : 'Exam 2'}</span>
              <span class="rt-xc__track rt-xc__track--split">
                <span class="rt-xc__lose" style={`--w: ${share(f.right_to_wrong, flipMax * 2)}`}>
                  <b>−{f.right_to_wrong}</b>
                </span>
                <span class="rt-xc__win" style={`--w: ${share(f.wrong_to_right, flipMax * 2)}`}>
                  <b>+{f.wrong_to_right}</b>
                </span>
              </span>
              <span class="rt-xc__value">
                <small>p = {f.p}</small>
              </span>
            </div>
          );
        })}
        <div class="rt-xc__row rt-xc__row--axis" aria-hidden="true">
          <span class="rt-xc__sides">
            <span>right in round 1 only</span>
            <span>right in round 2 only</span>
          </span>
        </div>
      </div>
      <figcaption>
        Questions whose answer changed between the two adapters. Round 2 wins more of them on both exams (p = {data.r1_to_r2.exam1.p} and {data.r1_to_r2.exam2.p}), so the direction repeats, but neither exam alone settles it.
      </figcaption>
    </figure>
  )
}

{
  kind === 'authors' && (
    <div class="rt-xa">
      <article>
        <p class="rt-xa__k">Teaches the adapter</p>
        <h4>Training examples</h4>
        <dl>
          <dt>Written by</dt><dd>Nemotron 3 Ultra, the teacher (open model, OpenMDW-1.1)</dd>
          <dt>What</dt><dd>821 examples in round 1 and 3,501 more in round 2, written on Nebius Token Factory. Every query was run before it was kept.</dd>
          <dt>Kept apart from the exams</dt><dd>Never used to score anything, and never overlapping with either exam (0 of 172 and 0 of 200 questions, queries or table sets).</dd>
        </dl>
      </article>
      {data.exams.map((e) => (
        <article>
          <p class="rt-xa__k">Tests the adapter · {e.rows} questions · {e.built}</p>
          <h4>{e.name}</h4>
          <dl>
            <dt>Written by</dt><dd>{e.writer}</dd>
            <dt>Why that matters</dt><dd>{e.writer_note}</dd>
            <dt>Industries</dt><dd>{e.industries}</dd>
            <dt>How it was checked</dt><dd>{e.checked}</dd>
            <dt>Fingerprint (SHA-256)</dt><dd class="rt-xa__hash">{e.fingerprint}</dd>
          </dl>
        </article>
      ))}
    </div>
  )
}

<style>
  .rt-xc {
    margin: 1.5rem 0;
    padding: 1.15rem 1.25rem 1rem;
    border: 1px solid var(--rt-line);
    border-radius: var(--rt-radius-lg, 16px);
    background: var(--rt-surface);
  }
  .rt-xc__plot {
    display: grid;
    grid-template-columns: minmax(6.5rem, 9.5rem) minmax(0, 1fr) minmax(4.5rem, 6.5rem);
    column-gap: 1rem;
    row-gap: 0.55rem;
    font-variant-numeric: tabular-nums;
  }
  .rt-xc__row,
  .rt-xc__group {
    display: contents;
  }
  .rt-xc__label {
    grid-column: 1;
    align-self: center;
    color: var(--rt-ink-2);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25;
    text-align: end;
  }
  .rt-xc__label small {
    display: block;
    color: var(--rt-muted);
    font-size: 0.75rem;
    font-weight: 400;
  }
  .rt-xc__row--key .rt-xc__label,
  .rt-xc__row--key .rt-xc__value {
    color: var(--rt-ink);
    font-weight: 650;
  }
  .rt-xc__track {
    grid-column: 2;
    position: relative;
    z-index: 1;
    height: 1.4rem;
    align-self: center;
  }
  .rt-xc__track--thin {
    display: block;
    height: 0.95rem;
  }
  .rt-xc__bars > .rt-xc__track {
    grid-column: auto;
  }
  /* A difficulty group: three thin bars, their counts at the bar ends, across the bar and value columns. */
  .rt-xc__bars {
    grid-column: 2 / span 2;
    display: grid;
    gap: 0.3rem;
    padding: 0.4rem 3.5rem 0.4rem 0;
  }
  .rt-xc__group .rt-xc__label {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 0.4rem;
  }
  .rt-xc__group + .rt-xc__group > * {
    border-top: 1px solid var(--rt-line);
  }
  .rt-xc__bar {
    position: absolute;
    inset: 0 auto 0 0;
    width: max(2px, var(--w));
    border-radius: 0.3rem;
    background: var(--c);
    opacity: var(--o);
  }
  .rt-xc__range {
    position: absolute;
    top: 50%;
    left: var(--lo);
    width: calc(var(--hi) - var(--lo));
    height: 0.6rem;
    translate: 0 -50%;
    border-inline: 1.5px solid var(--rt-ink);
    opacity: 0.75;
  }
  .rt-xc__range::before {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    translate: 0 -50%;
    background: var(--rt-ink);
  }
  .rt-xc__end {
    position: absolute;
    top: 50%;
    left: calc(var(--w) + 0.45rem);
    translate: 0 -50%;
    color: var(--rt-ink-2);
    font-size: 0.75rem;
    line-height: 1;
    white-space: nowrap;
  }
  .rt-xc__value {
    grid-column: 3;
    align-self: center;
    color: var(--rt-ink-2);
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .rt-xc__value small {
    margin-left: 0.2rem;
    color: var(--rt-muted);
    font-size: 0.75rem;
    font-weight: 400;
  }
  /* Gridlines: one layer behind the bars, the height of the rows. */
  .rt-xc__grid {
    grid-column: 2;
    position: relative;
    pointer-events: none;
  }
  .rt-xc__grid > span {
    position: absolute;
    inset-block: -0.2rem;
    left: var(--x);
    border-left: 1px dashed var(--rt-line-strong);
    opacity: 0.6;
  }
  .rt-xc__ticks,
  .rt-xc__sides {
    grid-column: 2;
    position: relative;
    height: 1rem;
    color: var(--rt-muted);
    font-size: 0.72rem;
  }
  .rt-xc__ticks > span {
    position: absolute;
    left: var(--x);
    translate: -50% 0;
  }
  .rt-xc__ticks > span:first-child {
    translate: 0 0;
  }
  .rt-xc__sides {
    display: flex;
    justify-content: space-between;
  }
  .rt-xc__track--split::before {
    content: '';
    position: absolute;
    inset-block: -0.3rem;
    left: 50%;
    border-left: 1px solid var(--rt-line-strong);
  }
  .rt-xc__lose,
  .rt-xc__win {
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--w);
    border-radius: 0.3rem;
  }
  .rt-xc__lose {
    right: 50%;
    background: color-mix(in srgb, var(--rt-bad) 85%, transparent);
  }
  .rt-xc__win {
    left: 50%;
    background: color-mix(in srgb, var(--rt-good) 90%, transparent);
  }
  .rt-xc__lose b,
  .rt-xc__win b {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    color: var(--rt-ink);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1;
  }
  .rt-xc__lose b {
    right: calc(100% + 0.4rem);
  }
  .rt-xc__win b {
    left: calc(100% + 0.4rem);
  }
  .rt-xc__key {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    margin: 0 0 0.85rem !important;
    color: var(--rt-muted);
    font-size: 0.78rem;
  }
  .rt-xc__key span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .rt-xc__key i {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 0.2rem;
    background: var(--c);
    opacity: var(--o);
  }
  .rt-xc figcaption {
    margin-top: 0.85rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--rt-line);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--rt-muted);
  }
  @media (max-width: 40rem) {
    .rt-xc {
      padding-inline: 0.9rem;
    }
    .rt-xc__plot {
      grid-template-columns: 5.5rem minmax(0, 1fr) auto;
      column-gap: 0.6rem;
    }
    .rt-xc__label {
      font-size: 0.8rem;
    }
    .rt-xc__value small {
      display: none;
    }
  }
  .rt-xa {
    display: grid;
    gap: 0.75rem;
    margin: 1.25rem 0;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    width: 100%;
  }
  .rt-xa > article {
    border: 1px solid var(--rt-line);
    border-radius: var(--rt-radius-lg, 16px);
    background: var(--rt-surface);
    padding: 1rem;
    min-width: 0;
    margin: 0 !important;
  }
  .rt-xa dl,
  .rt-xa dt,
  .rt-xa dd,
  .rt-xa h4,
  .rt-xa p {
    margin-inline: 0;
  }
  .rt-xa__k {
    margin: 0;
    font: 0.75rem var(--rt-font-mono, monospace);
    color: var(--rt-muted);
  }
  .rt-xa h4 {
    margin: 0.25rem 0 0.5rem !important;
    font-size: 1rem;
    color: var(--rt-ink);
  }
  .rt-xa dt {
    margin-top: 0.6rem !important;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--rt-muted);
  }
  .rt-xa dd {
    margin: 0.1rem 0 0 !important;
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--rt-ink-2);
  }
  .rt-xa__hash {
    font: 0.72rem var(--rt-font-mono, monospace);
    overflow-wrap: anywhere;
  }
</style>
