---
/**
 * ShapeGrid (React Bits, formerly "Squares"): the faint engineering grid behind the home hero; cells light up in
 * the owned blue under a mouse pointer, after one short intro ripple.
 * When: the home hero only (one background per site).
 * The grid itself is CSS, so it is there on every device. The canvas loads only on wide screens with a fine
 * pointer and no reduced-motion preference (client:media); everywhere else nothing is downloaded. The canvas is
 * transparent and never paints a background.
 */
import ShapeGridRB from '../rb/ShapeGrid/ShapeGrid.tsx';

interface Props {
  cellSize?: number;
  class?: string;
}

const { cellSize = 44, class: className } = Astro.props;
---

<div class:list={['rt-shape-grid', className]} style={`--rt-cell:${cellSize}px`} aria-hidden="true">
  <ShapeGridRB
    client:media="(min-width: 64em) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)"
    cellSize={cellSize}
  />
</div>

<style>
  .rt-shape-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, var(--rt-grid-strong) 1px, transparent 1px),
      linear-gradient(to bottom, var(--rt-grid-strong) 1px, transparent 1px);
    background-size: var(--rt-cell) var(--rt-cell);
    background-position: 0 0;
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 62% 38%, #000 30%, transparent 100%);
    mask-image: radial-gradient(ellipse 70% 80% at 62% 38%, #000 30%, transparent 100%);
  }
</style>
