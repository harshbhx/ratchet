---
/**
 * A band of the home page: an eyebrow with an index, a title that blurs in once (React Bits BlurText), an
 * optional lead and an optional link on the right, then the content.
 */
import BlurText from '../ui/BlurText.astro';

interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  index?: string;
  lead?: string;
  tint?: boolean;
}

const { id, title, eyebrow, index, lead, tint = false } = Astro.props;
---

<section class:list={['rt-home-section', 'rt-ui', { 'rt-home-section--tint': tint }]} id={id} aria-labelledby={`${id}-title`}>
  <div class="rt-home-section__inner">
    <header class="rt-home-section__head">
      <div class="rt-home-section__titles">
        {
          eyebrow && (
            <p class="rt-home-section__eyebrow">
              {index && <span class="rt-home-section__index">{index}</span>}
              {index && <span class="rt-home-section__rule" aria-hidden="true" />}
              <span>{eyebrow}</span>
            </p>
          )
        }
        <BlurText as="h2" id={`${id}-title`} text={title} class="rt-home-section__title" delay={45} duration={0.6} blur={8} distance={10} />
        {lead && <p class="rt-home-section__lead">{lead}</p>}
      </div>
      {Astro.slots.has('aside') && <div class="rt-home-section__aside"><slot name="aside" /></div>}
    </header>
    <slot />
  </div>
</section>

<style>
  .rt-home-section {
    position: relative;
    margin: 0 !important;
    padding-block: 3rem;
  }
  @media (min-width: 64rem) {
    .rt-home-section {
      padding-block: 4rem;
    }
  }
  .rt-home-section--tint {
    background:
      linear-gradient(to bottom, var(--rt-bg-sunken), var(--rt-bg) 85%);
    border-top: 1px solid var(--rt-line);
  }
  .rt-home-section__inner {
    width: 100%;
    max-width: 76rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }
  @media (min-width: 40rem) {
    .rt-home-section__inner {
      padding-inline: 2rem;
    }
  }
  @media (min-width: 64rem) {
    .rt-home-section__inner {
      padding-inline: 2.5rem;
    }
  }
  .rt-home-section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 2rem;
  }
  .rt-home-section__titles {
    max-width: 44rem;
  }
  .rt-home-section .rt-home-section__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 0.85rem;
    color: var(--rt-muted);
    font-family: var(--rt-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .rt-home-section__index {
    color: var(--rt-owned-ink);
  }
  .rt-home-section__rule {
    width: 2rem;
    height: 1px;
    background: var(--rt-line-strong);
  }
  .rt-home-section :global(.rt-home-section__title) {
    margin: 0;
    color: var(--rt-ink);
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.6rem);
    font-weight: 650;
    letter-spacing: -0.032em;
    line-height: 1.1;
    text-wrap: balance;
  }
  .rt-home-section .rt-home-section__lead {
    max-width: 40rem;
    margin: 0.9rem 0 0;
    color: var(--rt-ink-2);
    font-size: 1.05rem;
    line-height: 1.65;
  }
  .rt-home-section__aside {
    flex: none;
  }
</style>
