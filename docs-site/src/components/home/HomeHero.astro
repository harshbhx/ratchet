---
/**
 * The docs home's first screen: a compact, documentation-style header. A short title, one line on what Ratchet is, a
 * search call-out that opens Starlight's own search, and the three primary links. A quiet dot grid sits behind it
 * (CSS only, no motion). The main website carries the marketing hero; this page is for finding things.
 */
import RtIcon from '../RtIcon.astro';

interface Props {
  title: string;
  tagline?: string;
  actions: { text: string; link: string; variant: string }[];
}

const { title, tagline, actions } = Astro.props;
const variant = (v: string) => (v === 'outline' ? 'outline' : v === 'ghost' || v === 'minimal' ? 'ghost' : 'primary');
---

<section class="rt-dhero rt-ui" aria-labelledby="_top">
  <div class="rt-dhero__bg" aria-hidden="true"></div>
  <div class="rt-dhero__inner">
    <p class="rt-dhero__eyebrow">Documentation</p>
    <h1 id="_top" class="rt-dhero__title">{title}</h1>
    {tagline && <p class="rt-dhero__lead" set:html={tagline} />}

    <button type="button" class="rt-dhero__search" data-rt-open-search hidden>
      <RtIcon name="search" size={18} />
      <span class="rt-dhero__search-label">Search the docs</span>
      <kbd class="rt-dhero__kbd" aria-hidden="true"><span data-rt-mod>Ctrl</span> K</kbd>
    </button>

    {
      actions.length > 0 && (
        <div class="rt-dhero__actions">
          {actions.map((a, i) => (
            <a class={`rt-button rt-button--${variant(a.variant)}`} href={a.link}>
              {a.text}
              {i === 0 && (
                <svg class="rt-button__arrow" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>

<script>
  // Opens Starlight's search (its header button, or its Ctrl/Cmd+K shortcut). Without JavaScript the button stays hidden
  // and the header's search box is still there.
  const button = document.querySelector<HTMLButtonElement>('[data-rt-open-search]');
  if (button) {
    const mac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
    const mod = button.querySelector('[data-rt-mod]');
    if (mod) mod.textContent = mac ? '⌘' : 'Ctrl';
    button.hidden = false;
    button.addEventListener('click', () => {
      const trigger = document.querySelector<HTMLElement>('site-search button, button[data-open-modal]');
      if (trigger) {
        trigger.click();
        return;
      }
      window.dispatchEvent(new KeyboardEvent('keydown', { key: 'k', ctrlKey: !mac, metaKey: mac, bubbles: true }));
    });
  }
</script>

<style>
  .rt-dhero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    overflow: clip;
    border-bottom: 1px solid var(--rt-line);
  }
  .rt-dhero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(40rem 18rem at 12% -4rem, var(--rt-glow-owned), transparent 70%),
      radial-gradient(28rem 14rem at 96% 110%, var(--rt-glow-rented), transparent 70%),
      radial-gradient(circle at 1px 1px, var(--rt-grid-strong) 1px, transparent 0) 0 0 / 22px 22px;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }
  .rt-dhero__inner {
    width: 100%;
    max-width: 64rem;
    margin-inline: auto;
    padding: 2.5rem 1rem 2.25rem;
  }
  @media (min-width: 48rem) {
    .rt-dhero__inner {
      padding: 3.5rem 1.5rem 3rem;
    }
  }
  .rt-dhero__eyebrow {
    margin: 0 0 0.6rem;
    color: var(--rt-owned-ink);
    font-family: var(--rt-font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .rt-dhero .rt-dhero__title {
    margin: 0;
    color: var(--rt-ink);
    font-size: clamp(1.9rem, 1.4rem + 2vw, 2.75rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }
  .rt-dhero .rt-dhero__lead {
    max-width: 40rem;
    margin: 0.85rem 0 0;
    color: var(--rt-ink-2);
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .rt-dhero__search {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: 100%;
    max-width: 34rem;
    min-height: 3rem;
    margin-top: 1.5rem;
    padding: 0.6rem 0.75rem 0.6rem 1rem;
    border: 1px solid var(--rt-line-strong);
    border-radius: 0.85rem;
    background: var(--rt-surface);
    color: var(--rt-muted);
    box-shadow: var(--rt-shadow);
    font: inherit;
    font-size: 0.975rem;
    text-align: left;
    cursor: pointer;
    transition:
      border-color 0.2s var(--rt-ease),
      box-shadow 0.2s var(--rt-ease),
      color 0.2s var(--rt-ease);
  }
  .rt-dhero__search[hidden] {
    display: none;
  }
  .rt-dhero__search:hover {
    border-color: var(--rt-owned);
    color: var(--rt-ink);
    box-shadow: var(--rt-shadow-lift);
  }
  .rt-dhero__search:focus-visible {
    outline: 2px solid var(--rt-focus);
    outline-offset: 2px;
  }
  .rt-dhero__search-label {
    flex: 1;
  }
  .rt-dhero__kbd {
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--rt-line-strong);
    border-radius: 0.4rem;
    background: var(--rt-surface-2);
    color: var(--rt-muted);
    font-family: var(--rt-font-mono);
    font-size: 0.75rem;
    white-space: nowrap;
  }
  @media (hover: none) {
    .rt-dhero__kbd {
      display: none;
    }
  }
  .rt-dhero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }
</style>
