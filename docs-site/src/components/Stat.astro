---
/**
 * <Stat>: one number or short fact with a label, for a <StatRow>.
 * A numeric `value` counts up once (React Bits CountUp) unless count={false}; text values ("Apache-2.0") stay as they are.
 * tone: 'owned' (the student / what you own), 'rented' (the teacher), 'neutral' (default), or 'sim' for a
 * simulation number, which also prints a "Simulation" badge. Every number must come from the repo or a measured
 * run; a simulation number must use tone="sim".
 *
 *   <Stat value={1781} label="tests" note="Offline: no network, no GPU." />
 *   <Stat value={95} suffix="%" label="held-out precision floor" tone="owned" />
 *   <Stat value="Apache-2.0" label="open source license" />
 */
import CountUp from './ui/CountUp.astro';

interface Props {
  value: number | string;
  label: string;
  note?: string;
  tone?: 'owned' | 'rented' | 'neutral' | 'sim';
  prefix?: string;
  suffix?: string;
  separator?: string;
  decimals?: number;
  count?: boolean;
  href?: string;
}

const { value, label, note, tone = 'neutral', prefix = '', suffix = '', separator = ',', decimals, count = true, href } = Astro.props;
const numeric = typeof value === 'number' && Number.isFinite(value);
const Tag = href ? 'a' : 'div';
---

<Tag class:list={['rt-stat', 'rt-ui', `rt-stat--${tone}`]} href={href} data-numeric={numeric ? '' : undefined}>
  {tone === 'sim' && <span class="rt-stat__flag">Simulation</span>}
  <span class="rt-stat__value">
    {
      numeric && count ? (
        <CountUp to={value as number} prefix={prefix} suffix={suffix} separator={separator} decimals={decimals} />
      ) : (
        <>
          {prefix}
          {numeric ? (value as number).toLocaleString('en-US', { maximumFractionDigits: decimals ?? 2 }) : value}
          {suffix}
        </>
      )
    }
  </span>
  <span class="rt-stat__label">{label}</span>
  {note && <span class="rt-stat__note">{note}</span>}
</Tag>

<style>
  .rt-stat {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
    padding: 1.15rem 1.2rem 1.2rem;
    border: 1px solid var(--rt-line);
    border-radius: var(--rt-radius-lg);
    background:
      linear-gradient(to bottom, color-mix(in srgb, var(--rt-surface-2) 60%, transparent), transparent 70%),
      var(--rt-surface);
    color: var(--rt-ink-2);
    text-decoration: none;
    overflow: hidden;
  }
  .rt-stat::before {
    content: '';
    position: absolute;
    left: 1.2rem;
    top: 0;
    width: 1.75rem;
    height: 2px;
    border-radius: 0 0 2px 2px;
    background: var(--rt-line-strong);
  }
  .rt-stat--owned::before {
    background: var(--rt-owned);
  }
  .rt-stat--rented::before {
    background: var(--rt-rented);
  }
  .rt-stat--sim::before {
    background: var(--rt-warn);
  }
  a.rt-stat {
    transition:
      border-color var(--rt-dur) ease,
      transform 0.25s var(--rt-ease);
  }
  a.rt-stat:focus-visible {
    outline-offset: -2px;
  }
  a.rt-stat:hover {
    border-color: var(--rt-line-strong);
    transform: translateY(-2px);
  }
  .rt-stat__value {
    display: block;
    color: var(--rt-ink);
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.15rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .rt-stat:not([data-numeric]) .rt-stat__value {
    font-variant-numeric: normal;
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.55rem);
    letter-spacing: -0.025em;
    line-height: 1.2;
  }
  .rt-stat--owned .rt-stat__value {
    color: var(--rt-owned-ink);
  }
  .rt-stat--rented .rt-stat__value {
    color: var(--rt-rented-ink);
  }
  .rt-stat__label {
    color: var(--rt-ink);
    font-size: 0.9rem;
    font-weight: 550;
    line-height: 1.4;
  }
  .rt-stat__note {
    color: var(--rt-muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .rt-stat__flag {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    padding: 0.05rem 0.45rem;
    border: 1px solid color-mix(in srgb, var(--rt-warn) 45%, transparent);
    border-radius: 999px;
    background: var(--rt-warn-soft);
    color: var(--rt-warn-ink);
    font-family: var(--rt-font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
