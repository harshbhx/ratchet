---
// Every component and how they connect. Colours: owned blue = the student, rented orange = the teacher,
// dashed = the hosted fallback, neutral = Ratchet and infrastructure (web/DESIGN.md).
import Figure from './Figure.astro';
import { connector, head, type Pt } from './geom';

const edges: Array<{ pts: Pt[]; cls: 'line' | 'line-owned' | 'line-rented' | 'line-dash' }> = [
  { pts: [[160, 76], [212, 76]], cls: 'line' }, // app -> Caddy
  { pts: [[341, 100], [341, 124]], cls: 'line' }, // Caddy -> gateway
  { pts: [[470, 150], [504, 150], [504, 80], [556, 80]], cls: 'line-rented' }, // gateway -> teacher
  { pts: [[470, 176], [518, 176], [518, 162], [556, 162]], cls: 'line-dash' }, // gateway -> hosted fallback
  { pts: [[470, 202], [532, 202], [532, 303], [556, 303]], cls: 'line-owned' }, // gateway -> student endpoint
  { pts: [[341, 242], [341, 266]], cls: 'line' }, // gateway -> ledger
  { pts: [[341, 336], [341, 360]], cls: 'line' }, // ledger -> Night School
  { pts: [[470, 386], [556, 386]], cls: 'line' }, // Night School -> bucket
  { pts: [[470, 430], [513, 430], [513, 466], [556, 466]], cls: 'line' }, // Night School -> job
  { pts: [[712, 438], [712, 414]], cls: 'line' }, // job -> bucket
  { pts: [[712, 358], [712, 334]], cls: 'line-owned' }, // bucket -> endpoint
  { pts: [[212, 220], [186, 220], [186, 332], [160, 332]], cls: 'line' }, // gateway -> Tavily
];
const headClass = { line: 'head', 'line-dash': 'head', 'line-owned': 'head-owned', 'line-rented': 'head-rented' };
---

<Figure minWidth={600} legend={['owned', 'rented', 'fallback', 'neutral']}>
  <svg class="rt-svg" viewBox="0 0 900 512" role="img" aria-labelledby="bp-title bp-desc">
    <title id="bp-title">The big picture: every part of Ratchet and how they connect</title>
    <desc id="bp-desc">
      Your app sends OpenAI-style requests over HTTPS to Caddy and the gateway on a CPU VM. The gateway sends student
      calls to a Nebius Serverless Endpoint running vLLM with Nemotron 3 Nano 4B and your LoRA adapter, escalations and
      audits to the teacher Nemotron 3 Ultra on Token Factory, and student calls to the hosted Nano 30B fallback when
      the endpoint is off. Every request is written to the SQLite ledger. Night School, run by cron, reads the teacher
      answers, uploads train.jsonl to an Object Storage bucket, starts a Serverless Job on an L40S GPU that writes a new
      adapter to the bucket, and the endpoint loads it from the same bucket. Scout searches the web with Tavily.
    </desc>

    <!-- Left column -->
    <text class="eyebrow" x="16" y="28">Your side</text>
    <rect class="box-plain" x="16" y="40" width="144" height="72" rx="10"></rect>
    <text class="t" x="30" y="70">Your app</text>
    <text class="t2" x="30" y="92">any OpenAI SDK</text>

    <text class="eyebrow" x="16" y="290">Search</text>
    <rect class="box" x="16" y="300" width="144" height="64" rx="10"></rect>
    <text class="t" x="30" y="326">Tavily</text>
    <text class="t2" x="30" y="348">Scout's web search</text>

    <!-- Gateway host -->
    <rect class="zone" x="196" y="12" width="290" height="456" rx="16"></rect>
    <text class="eyebrow" x="212" y="34">Gateway host · CPU VM</text>

    <rect class="box" x="212" y="52" width="258" height="48" rx="10"></rect>
    <text class="t" x="228" y="81">Caddy</text>
    <text class="tm" x="456" y="81" text-anchor="end">HTTPS · edge guard</text>

    <rect class="box-plain" x="212" y="124" width="258" height="118" rx="12" style="stroke-width:1.75"></rect>
    <text class="t" x="228" y="150">Gateway</text>
    <text class="t2" x="228" y="173">OpenAI-compatible /v1 API</text>
    <text class="t2" x="228" y="194">cascade · release gate · cost</text>
    <text class="mono tm" x="228" y="222">/ · /scout · /dashboard</text>

    <rect class="box" x="212" y="266" width="258" height="70" rx="10"></rect>
    <text class="t" x="228" y="292">Ledger</text>
    <text class="t2" x="228" y="315">SQLite · examples with provenance</text>

    <rect class="box" x="212" y="360" width="258" height="92" rx="10"></rect>
    <text class="t" x="228" y="386">Night School (cron)</text>
    <text class="mono tm" x="228" y="409">python -m ratchet.live night</text>
    <text class="t2" x="228" y="432">also: gate tick · seal receipts</text>

    <!-- Token Factory -->
    <rect class="zone" x="540" y="12" width="344" height="204" rx="16"></rect>
    <text class="eyebrow" x="556" y="34">Nebius Token Factory · per token</text>

    <rect class="rented" x="556" y="52" width="312" height="56" rx="10"></rect>
    <text class="t" x="572" y="76">Teacher · Nemotron 3 Ultra</text>
    <text class="t2 rented-t" x="572" y="97">answers escalations and audits</text>

    <rect class="fallback" x="556" y="124" width="156" height="76" rx="10"></rect>
    <text class="t" x="570" y="150">Fallback</text>
    <text class="t2" x="570" y="171">Nano 30B, untuned</text>
    <text class="tm" x="570" y="190">while endpoint is off</text>

    <rect class="box" x="724" y="124" width="144" height="76" rx="10"></rect>
    <text class="t" x="738" y="150">Judge</text>
    <text class="t2" x="738" y="171">Nemotron 3 Super</text>
    <text class="tm" x="738" y="190">free-text eval</text>

    <!-- AI Cloud -->
    <rect class="zone" x="540" y="236" width="344" height="268" rx="16"></rect>
    <text class="eyebrow" x="556" y="258">Nebius AI Cloud · per GPU-hour</text>

    <rect class="owned" x="556" y="272" width="312" height="62" rx="10"></rect>
    <text class="t" x="572" y="297">Student · Serverless Endpoint</text>
    <text class="t2 owned-t" x="572" y="319">vLLM · Nano 4B + your LoRA adapter</text>

    <rect class="box" x="556" y="358" width="312" height="56" rx="10"></rect>
    <text class="t" x="572" y="382">Object Storage bucket</text>
    <text class="mono tm" x="572" y="403">/data: night/ · adapters/</text>

    <rect class="box" x="556" y="438" width="312" height="56" rx="10"></rect>
    <text class="t" x="572" y="462">Serverless Job · L40S</text>
    <text class="t2" x="572" y="483">trains a new adapter each night</text>

    <!-- Connectors -->
    {
      edges.map((e) => (
        <g>
          <path class={e.cls} d={connector(e.pts)} />
          <polygon class={headClass[e.cls]} points={head(e.pts)} />
        </g>
      ))
    }

    <!-- Connector labels (with a backing so they read over zone borders) -->
    <rect class="lbl-bg" x="164" y="56" width="44" height="14" rx="3"></rect>
    <text class="lbl" x="186" y="67" text-anchor="middle">HTTPS</text>
    <text class="lbl" x="350" y="258">every request</text>
    <text class="lbl" x="350" y="352">teacher answers</text>
    <rect class="lbl-bg" x="478" y="366" width="70" height="14" rx="3"></rect>
    <text class="lbl mono" x="513" y="377" text-anchor="middle">train.jsonl</text>
    <text class="lbl" x="722" y="430">writes adapter</text>
    <text class="lbl owned-t" x="722" y="350">hot-loads adapter</text>
  </svg>
  <Fragment slot="caption">
    <p>
      <strong>The big picture.</strong> Your app calls the gateway like any OpenAI endpoint. The gateway asks the student first
      (blue) and escalates to the teacher on Token Factory (orange); every request is written to the ledger. Each night, Night
      School uploads the teacher's answers to the bucket, a Serverless Job trains a new adapter into the same bucket, and the
      endpoint loads it from there. While the GPU endpoint is off, the hosted Nano 30B answers student calls (dashed).
    </p>
  </Fragment>
</Figure>
