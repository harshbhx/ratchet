---
// One request through the cascade (ratchet/router.py, Ratchet.handle). Owned blue = the student, rented orange = the
// teacher. Thresholds and rates are settings, so the figure names them rather than giving numbers.
import Figure from './Figure.astro';
import { connector, head, type Pt } from './geom';

type Cls = 'line' | 'line-owned' | 'line-rented' | 'line-dash';
const edges: Array<{ pts: Pt[]; cls: Cls }> = [
  { pts: [[140, 200], [160, 200]], cls: 'line' }, // request -> student
  { pts: [[360, 200], [390, 200]], cls: 'line-owned' }, // student -> decision
  { pts: [[470, 144], [470, 86], [580, 86]], cls: 'line-owned' }, // yes -> serve
  { pts: [[784, 86], [812, 86]], cls: 'line-dash' }, // serve -> audit (sometimes)
  { pts: [[470, 256], [470, 314], [580, 314]], cls: 'line-rented' }, // no -> teacher
  { pts: [[784, 314], [812, 314]], cls: 'line' }, // teacher -> store
  { pts: [[878, 120], [878, 280]], cls: 'line-dash' }, // audit answer -> store
  { pts: [[878, 356], [878, 404]], cls: 'line' }, // store -> ledger
  { pts: [[78, 228], [78, 382], [682, 382], [682, 348]], cls: 'line-rented' }, // pinned or tools -> teacher
];
const headClass: Record<Cls, string> = { line: 'head', 'line-dash': 'head', 'line-owned': 'head-owned', 'line-rented': 'head-rented' };
---

<Figure minWidth={600} legend={['owned', 'rented', 'neutral']}>
  <svg class="rt-svg" viewBox="0 0 952 452" role="img" aria-labelledby="rj-title rj-desc">
    <title id="rj-title">One request's journey through the gateway</title>
    <desc id="rj-desc">
      A request first goes to the student, which samples three answers. If the answers agree and the confidence score
      reaches the version's threshold, the student's answer is served, and a random sample of served answers is audited
      by the teacher. Otherwise, or if the student call failed, the request escalates and the teacher's answer is served.
      Teacher answers that are complete and valid are stored as training examples, redacted and with their provenance.
      Pinned tasks and tool calls go to the teacher only and are never stored. Every request is logged in the ledger.
    </desc>

    <rect class="box-plain" x="16" y="172" width="124" height="56" rx="10"></rect>
    <text class="t" x="32" y="197">Request</text>
    <text class="tm" x="32" y="216">from your app</text>

    <rect class="owned" x="160" y="156" width="200" height="88" rx="12"></rect>
    <text class="t" x="176" y="184">Student, 3 samples</text>
    <text class="t2 owned-t" x="176" y="206">Nano + your adapter</text>
    <text class="mono tm" x="176" y="228">temp 0.7 · logprobs</text>

    <polygon class="box-plain" points="470,144 550,200 470,256 390,200" style="stroke-width:1.5"></polygon>
    <text class="t" x="470" y="197" text-anchor="middle">Confident?</text>
    <text class="tm" x="470" y="217" text-anchor="middle">≥ threshold</text>

    <rect class="owned" x="580" y="52" width="204" height="68" rx="10"></rect>
    <text class="t" x="596" y="80">Serve the student</text>
    <text class="t2 owned-t" x="596" y="101">student tokens only</text>

    <rect class="box" x="812" y="52" width="132" height="68" rx="10"></rect>
    <text class="t" x="826" y="80">Audit</text>
    <text class="t2" x="826" y="101">random sample</text>

    <rect class="rented" x="580" y="280" width="204" height="68" rx="10"></rect>
    <text class="t" x="596" y="308">Teacher answers</text>
    <text class="t2 rented-t" x="596" y="329">Ultra, served to you</text>

    <rect class="box" x="812" y="280" width="132" height="76" rx="10"></rect>
    <text class="t" x="826" y="304">Store</text>
    <text class="t2" x="826" y="324">redacted, with</text>
    <text class="t2" x="826" y="343">provenance</text>

    <rect class="box" x="16" y="404" width="928" height="40" rx="10"></rect>
    <text class="t" x="32" y="429">Ledger</text>
    <text class="t2" x="100" y="429">every request is logged: route, confidence, cost, who answered</text>

    {
      edges.map((e) => (
        <g>
          <path class={e.cls} d={connector(e.pts)} />
          <polygon class={headClass[e.cls]} points={head(e.pts)} />
        </g>
      ))
    }

    <text class="lbl owned-t" x="480" y="118">yes</text>
    <text class="lbl rented-t" x="480" y="290">no, or the student failed</text>
    <text class="lbl" x="870" y="205" text-anchor="end">the audit's answer too</text>
    <rect class="lbl-bg" x="96" y="364" width="300" height="14" rx="3"></rect>
    <text class="lbl rented-t" x="100" y="375">pinned task or tool call: teacher only, never stored</text>
  </svg>
  <Fragment slot="caption">
    <p>
      <strong>One request.</strong> The student answers first (blue). If its samples agree and its score reaches the version's
      threshold, its answer is served, and a random few of those are audited by the teacher. Otherwise the teacher (orange)
      answers. Complete, valid teacher answers are stored for training, redacted and with their provenance; the student's own
      answers never are. While the GPU endpoint is off, the hosted Nano 30B takes the student's place.
    </p>
  </Fragment>
</Figure>
