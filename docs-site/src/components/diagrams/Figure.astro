---
/**
 * The frame every hand-drawn diagram sits in: a bordered card, the SVG (scrolls sideways on narrow screens instead of
 * shrinking its text), and a caption with the colour legend. The caption also says in words what the picture shows.
 */
interface Props {
  /** Minimum drawn width in CSS pixels; below it the figure scrolls sideways. */
  minWidth?: number;
  legend?: Array<'owned' | 'rented' | 'fallback' | 'neutral'>;
}
const { minWidth = 620, legend = [] } = Astro.props;
const LEGEND = {
  owned: 'Student: Nano with the adapter you own',
  rented: 'Teacher you rent per token',
  fallback: 'Hosted fallback (untuned)',
  neutral: 'Ratchet and infrastructure',
} as const;
---

<figure class="rt-figure">
  <div class="rt-figure-scroll" style={`--rt-min:${minWidth}px`} tabindex="0" role="group" aria-label="Diagram (scrolls sideways on small screens)">
    <slot />
  </div>
  <figcaption>
    <p class="rt-figure-hint">Swipe sideways to see the whole diagram.</p>
    <slot name="caption" />
    {
      legend.length > 0 && (
        <div class="rt-legend">
          {legend.map((k) => (
            <span class={k}>
              <i />
              {LEGEND[k]}
            </span>
          ))}
        </div>
      )
    }
  </figcaption>
</figure>

<style>
  .rt-figure-scroll :global(svg) {
    min-width: var(--rt-min);
  }
  .rt-figure-scroll:focus-visible {
    outline-offset: -2px;
  }
</style>
