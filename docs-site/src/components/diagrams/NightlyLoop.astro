---
// One night of Night School (ratchet/nightschool/orchestrate.py, run_night) and the release that follows
// (ratchet/release.py). The traffic shares are the release policy's stages, not measured results.
import Figure from './Figure.astro';
import { connector, head, type Pt } from './geom';

type Cls = 'line' | 'line-owned' | 'line-dash' | 'line-bad';
const xs = [16, 206, 396, 586, 776];
const W = 168;
const edges: Array<{ pts: Pt[]; cls: Cls }> = [
  // Tonight, left to right
  ...[0, 1, 2, 3].map((i): { pts: Pt[]; cls: Cls } => ({ pts: [[xs[i] + W, 84], [xs[i + 1], 84]], cls: 'line' })),
  // Wrap down to the release row
  { pts: [[860, 124], [860, 150], [60, 150], [60, 196]], cls: 'line' },
  // Release row
  { pts: [[xs[0] + W, 232], [xs[1], 232]], cls: 'line-owned' },
  { pts: [[xs[1] + W, 232], [xs[2], 232]], cls: 'line-owned' },
  { pts: [[xs[2] + W, 232], [xs[3], 232]], cls: 'line-owned' },
  { pts: [[xs[3] + W, 232], [xs[4], 232]], cls: 'line-owned' },
  // Cold start skips shadow
  { pts: [[150, 196], [150, 178], [480, 178], [480, 196]], cls: 'line-dash' },
  // Failures
  { pts: [[100, 268], [100, 314]], cls: 'line-bad' },
  { pts: [[480, 268], [480, 314]], cls: 'line-bad' },
  { pts: [[670, 268], [670, 314]], cls: 'line-bad' },
];
const headClass: Record<Cls, string> = { line: 'head', 'line-dash': 'head', 'line-owned': 'head-owned', 'line-bad': 'head-bad' };
const tonight = [
  { t: 'Check first', a: 'training not paused', b: 'no release in flight' },
  { t: 'Build the data', a: 'teacher answers only', b: 'golden set held out' },
  { t: 'Re-score live', a: "on tonight's golden set", b: 'same data for both' },
  { t: 'Train an adapter', a: 'Serverless Job, L40S', b: 'LoRA from the base' },
  { t: 'Golden eval', a: 'threshold: even rows', b: 'precision: odd rows' },
];
const release = [
  { t: 'Golden gate', a: 'precision · coverage', b: 'no regression vs live', share: null },
  { t: 'Shadow', a: 'runs silently', b: 'serves no one', share: 0 },
  { t: 'Canary 10%', a: 'teacher audits', b: 'enough audits to move', share: 0.1 },
  { t: 'Canary 50%', a: 'teacher audits', b: 'enough audits to move', share: 0.5 },
  { t: 'Live 100%', a: 'old version retired', b: 'still audited', share: 1 },
];
---

<Figure minWidth={600} legend={['owned', 'neutral']}>
  <svg class="rt-svg" viewBox="0 0 952 372" role="img" aria-labelledby="nl-title nl-desc">
    <title id="nl-title">One night of Night School, then the release gate</title>
    <desc id="nl-desc">
      Tonight: check that training is not paused and no release is in flight; build the dataset from teacher answers only
      with the golden set held out; re-score the live version on tonight's golden set; train a new LoRA adapter from the
      base model on a Serverless Job; evaluate it on the golden set, calibrating the threshold on even rows and measuring
      precision on odd rows. Then the release gate: the golden gate checks precision, coverage and no regression against
      live, or rejects the candidate. A passing candidate runs in shadow, then canary at 10 percent and 50 percent of
      traffic with teacher audits, then goes live. With no live version (cold start) it goes straight to canary 10 percent.
      A canary whose audited precision bound falls below the floor is rolled back automatically.
    </desc>

    <text class="eyebrow" x="16" y="28">Tonight · python -m ratchet.live night</text>
    {
      tonight.map((b, i) => (
        <g>
          <rect class={i === 3 ? 'box-plain' : 'box'} x={xs[i]} y="44" width={W} height="80" rx="10" style={i === 3 ? 'stroke-width:1.75' : undefined} />
          <text class="eyebrow" x={xs[i] + 14} y="64">{`0${i + 1}`}</text>
          <text class="t" x={xs[i] + 14} y="85">{b.t}</text>
          <text class="tm" x={xs[i] + 14} y="104">{b.a}</text>
          <text class="tm" x={xs[i] + 14} y="118">{b.b}</text>
        </g>
      ))
    }

    <rect class="lbl-bg" x="584" y="141" width="190" height="16" rx="3"></rect>
    <text class="eyebrow" x="590" y="153">Then · the release gate</text>

    {
      release.map((b, i) => (
        <g>
          <rect class={b.share === null ? 'box' : 'owned'} x={xs[i]} y="196" width={W} height="72" rx="10" style={b.share === null ? undefined : `fill-opacity:${0.35 + 0.65 * (b.share ?? 0)}`} />
          <text class="t" x={xs[i] + 14} y="220">{b.t}</text>
          <text class="tm" x={xs[i] + 14} y="239">{b.a}</text>
          {b.share === null ? (
            <text class="tm" x={xs[i] + 14} y="256">{b.b}</text>
          ) : (
            <g>
              <rect class="pill" x={xs[i] + 14} y="248" width={W - 28} height="8" rx="4" />
              {b.share > 0 && <rect class="head-owned" x={xs[i] + 14} y="248" width={Math.max(8, (W - 28) * b.share)} height="8" rx="4" />}
            </g>
          )}
        </g>
      ))
    }

    <rect class="bad" x="16" y="314" width="168" height="50" rx="10"></rect>
    <text class="t" x="30" y="336">Rejected</text>
    <text class="tm" x="30" y="354">nothing ships</text>

    <rect class="bad" x="396" y="314" width="358" height="50" rx="10"></rect>
    <text class="t" x="410" y="336">Rolled back automatically</text>
    <text class="tm" x="410" y="354">audit bound below the floor; live keeps serving</text>

    {
      edges.map((e) => (
        <g>
          <path class={e.cls === 'line-bad' ? 'line-dash' : e.cls} d={connector(e.pts)} style={e.cls === 'line-bad' ? 'stroke:var(--rt-bad)' : undefined} />
          <polygon class={headClass[e.cls]} points={head(e.pts)} style={e.cls === 'line-bad' ? 'fill:var(--rt-bad)' : undefined} />
        </g>
      ))
    }
    <rect class="lbl-bg" x="236" y="170" width="200" height="14" rx="3"></rect>
    <text class="lbl" x="240" y="181">cold start: no live version yet</text>
  </svg>
  <Fragment slot="caption">
    <p>
      <strong>One night, then a careful release.</strong> Night School trains only on teacher answers and never on the golden
      set, re-scores the live version on the same golden rows the same night, and trains a fresh adapter from the base model.
      A candidate that passes the golden gate earns traffic in steps: shadow (serves no one), then 10%, 50% and 100%, each
      stage gated on teacher audits. The bars show the share of traffic each stage serves under the release policy, not
      measured results. No new training starts while a release is in flight.
    </p>
  </Fragment>
</Figure>
