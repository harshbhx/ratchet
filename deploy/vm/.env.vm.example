# Ratchet demo VM settings. On the VM: cp .env.vm.example .env, then edit .env.
# Never commit .env. Never put real keys in this example file.
# Full reference: docs/DEPLOY_NEBIUS_VM.md and docs/CONFIGURATION.md
#
# Keep comments on their own lines: this file is read by Docker Compose and by deploy/vm/*.sh.

# --- Web address --------------------------------------------------------------
# Your DNS name (an A record pointing at the VM's public IP), e.g. ratchet.dualmindlab.tech.
# No DNS yet? Use <public-ip>.sslip.io, e.g. 203.0.113.7.sslip.io: it resolves to that IP,
# so Caddy can get a real certificate at once. cloud-init fills this in on first boot if it
# is still the placeholder below.
RATCHET_DOMAIN=ratchet.example.com

# --- Mode ---------------------------------------------------------------------
# mock: simulated models, no keys, no cost. Start here.
# live: real Nemotron on Nebius Token Factory and real web search (costs money).
RATCHET_MODE=mock

# Mock only: simulated days to run at startup, so the dashboard opens on a student that
# has already been trained instead of a cold start. 0 turns it off.
RATCHET_MOCK_WARMUP_DAYS=4

# SQLite ledger inside the ratchet-data volume (live mode; mock mode keeps it in memory).
RATCHET_DB=/data/ratchet.db

# --- Live mode keys (leave empty in mock mode) ---------------------------------
# Token Factory API key: teacher, judge and fallback student.
NEBIUS_API_KEY=
# Tavily Search key for Scout's searcher agent.
TAVILY_API_KEY=

# Student on a Nebius Serverless Endpoint (vLLM). Leave both empty to use the hosted,
# untuned fallback student on Token Factory (pay per token, no GPU running).
RATCHET_STUDENT_BASE=
RATCHET_STUDENT_KEY=

# --- Budget guard for the public demo (live mode) ------------------------------
# Most Scout may spend per UTC day, in USD. When reached, Scout answers 429.
# 0.50/day keeps the worst case over Oct 29 - Dec 15 (48 days) at $24, inside the $25 Builder credit.
RATCHET_SCOUT_DAILY_BUDGET_USD=0.50
# Scout runs allowed per client IP per hour.
RATCHET_SCOUT_RUNS_PER_HOUR=6
# Scout runs allowed per UTC day across all visitors, judges included. Caps Tavily credits (about 3 searches
# per run). With the judges' reserve below, 22 leaves the public 15 runs a day.
RATCHET_SCOUT_MAX_RUNS_PER_DAY=30
# Share of student answers also checked by the teacher. Each audit is a paid Ultra call.
RATCHET_AUDIT_RATE=0.05
# The counters above survive restarts and update.sh: they are kept in the ledger (live mode).

# --- Judges and Tavily credits (live mode; docs/CONFIGURATION.md) --------------
# Runs per UTC day held back for hackathon judges, unlocked by an access code that goes in the
# submission's testing instructions only (never on the project page, in the video or in a URL).
# Set both or neither. Generate the code with: openssl rand -hex 16
# RATCHET_SCOUT_JUDGE_CODE=
# RATCHET_SCOUT_JUDGE_RUNS_PER_DAY=7
# Judges' USD per day; unset = their share of the daily budget (7/22 of 0.50 = 0.15).
# RATCHET_SCOUT_JUDGE_BUDGET_USD=
# Tavily credits per cycle (free plan: 1,000 a month), the judges' share (unset = 7/22 of it),
# the day of the month the cycle starts (Tavily's reset day is unverified) and the date the
# daily allowance is spread until (the last day of judging).
# RATCHET_TAVILY_MONTHLY_CREDITS=1000
# RATCHET_TAVILY_JUDGE_CREDITS=
# RATCHET_TAVILY_CYCLE_DAY=1
# RATCHET_TAVILY_PACE_UNTIL=2026-12-15

# --- Edge access control (Caddy) ----------------------------------------------
# open:    everything is public, including /v1/chat/completions (no auth in v0.1).
# guarded: /v1/* and /ratchet/demo/* need the header X-Ratchet-Admin-Token: <token>.
#          The UI stays public: /, /scout, /dashboard, /ratchet/stats, /ratchet/bom.
#          In mock mode this also disables the dashboard's Run day / Break / Reset buttons.
RATCHET_API_GUARD=open
# At least 32 characters, hex only. Generate with: openssl rand -hex 32
RATCHET_ADMIN_TOKEN=

# --- Gateway API keys (in the app, works with or without the Caddy guard) -------
# name:key pairs, comma-separated; each key at least 16 characters. When set, /v1/* needs
# "Authorization: Bearer <key>" (what OpenAI SDKs send). Pages, Scout and /healthz stay public.
# Generate a key with: openssl rand -hex 24
RATCHET_API_KEYS=
# Requests per key per UTC day on /v1/chat/completions. 0 = unlimited.
RATCHET_API_KEY_DAILY_REQUESTS=0
# Admin keys for task management (PUT/DELETE /ratchet/tasks/...), same syntax, never the same keys
# as RATCHET_API_KEYS. Empty: task writes are refused in live mode and open to anyone in mock mode.
RATCHET_ADMIN_KEYS=

# --- Privacy and provenance ------------------------------------------------------
# Replace emails, phone numbers, card numbers and similar with placeholders before storing
# training examples. 1 = on (default).
RATCHET_REDACT_PII=1
# Ed25519 key that signs each adapter's bill of materials. Generate on your laptop with
# `python -m ratchet.bom keygen` and publish the public key it prints. Empty = unsigned.
RATCHET_BOM_SIGNING_KEY=

# --- Optional: backups to Nebius Object Storage (deploy/vm/backup.sh) -----------
# s3://<bucket>/<prefix>. Empty = keep backups on the VM only.
RATCHET_BUCKET_S3=
# S3 endpoint for Object Storage. Copy it from the console (verify on day 1).
RATCHET_S3_ENDPOINT=
