# Copy to .env (never commit .env). Everything here is optional.
# DEMO_PORT=18000          # the port on 127.0.0.1 that the demo answers on
# MEM_GATEWAY=1536m        # RAM limit of the demo container (the tunnel gets 256m on top); keep the total under 3g
# TUNNEL_TOKEN=            # only with: docker compose --profile tunnel up -d
