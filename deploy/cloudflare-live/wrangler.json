{
  "name": "ratchet-live",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "containers": [
    {
      "class_name": "RatchetLive",
      "image": "../../Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "RatchetLive",
        "name": "RATCHET_LIVE"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RatchetLive"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "live.ratchet.dualmindlab.tech",
      "custom_domain": true
    }
  ]
}
